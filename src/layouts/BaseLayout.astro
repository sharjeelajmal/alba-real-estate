---
import '@fontsource-variable/inter';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@/styles/global.css';

import Analytics from '@/components/layout/Analytics.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import Seo from '@/components/layout/Seo.astro';
import type { SeoProps } from '@/types/site';

interface Props extends SeoProps {
  /** landing = focused ads layout (no navigation, compact footer) */
  variant?: 'site' | 'landing' | 'guide';
}

const { variant = 'site', ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <Seo {...seo} />
    <Analytics />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-60 focus:rounded-full focus:bg-primary focus:px-5 focus:py-3 focus:text-primary-foreground"
    >
      Skip to content
    </a>
    {variant !== 'guide' && <Header variant={variant} />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {variant !== 'guide' && <Footer variant={variant} />}
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
