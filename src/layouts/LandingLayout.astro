---
/**
 * Layout for Meta ads pages.
 * guide = minimal guide landing pages (they render their own top bar and compliance footer)
 * landing = focused layout with logo-only header and compact footer (thank-you pages)
 */
import BaseLayout from './BaseLayout.astro';
import type { SeoProps } from '@/types/site';

interface Props extends SeoProps {
  variant?: 'landing' | 'guide';
}
const { variant = 'landing', ...seo } = Astro.props;
---

<BaseLayout {...seo} variant={variant}>
  <slot name="head" slot="head" />
  <slot />
</BaseLayout>
