---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/lib/site';
---

<BaseLayout title="Page not found" description="The page you are looking for could not be found." noindex>
  <Section containerSize="prose" class="text-center">
    <Eyebrow line={false} class="animate-enter">Error 404</Eyebrow>
    <Heading level={1} class="mt-4 animate-enter animation-delay-100">This page has moved or no longer exists</Heading>
    <p class="mt-5 text-lead text-muted-foreground animate-enter animation-delay-200">Let's get you back on track.</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3 animate-enter animation-delay-300">
      <Button href="/" iconAfter="arrow-right">Go to homepage</Button>
      <Button href={site.links.calendly} external variant="outline" icon="calendar" track="ScheduleCallClick">Book a Review</Button>
    </div>
  </Section>
</BaseLayout>
