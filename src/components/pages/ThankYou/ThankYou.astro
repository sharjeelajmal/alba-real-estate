---
/** Post-submit page: instant PDF download + next step (book a review). Fires the Lead event once. */
import AdvisorsChip from '@/components/shared/AdvisorsChip.astro';
import GoldSwoosh from '@/components/shared/GoldSwoosh.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/lib/site';
import type { Guide } from '@/types/site';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const { thankYou } = guide;
---

<section class="ambient-glow relative overflow-hidden py-(--spacing-section)" data-lead-confirmation>
  <GoldSwoosh class="absolute inset-0 h-full w-full" />
  <Container size="prose" class="relative text-center">
    <span class="mx-auto grid size-16 place-items-center sm:size-20 rounded-full bg-linear-to-b from-gold-500 to-gold-700 text-surface shadow-gold animate-enter-scale">
      <Icon name="check" class="size-9" strokeWidth={2.4} />
    </span>
    <Heading level={1} class="mt-5 animate-enter animation-delay-150 sm:mt-8">{thankYou.title}</Heading>
    <p class="mx-auto mt-3 max-w-lg text-small text-muted-foreground animate-enter animation-delay-250 sm:mt-5 sm:text-lead">{thankYou.text}</p>
    <div class="mt-7 flex justify-center animate-enter animation-delay-350 sm:mt-10">
      <Button href={guide.pdf} download variant="accent" size="lg" icon="download" arrow>{thankYou.downloadLabel}</Button>
    </div>
  </Container>

  <Container class="relative mt-10 sm:mt-20">
    <Card variant="dark" padding="lg" class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.4fr_1fr]" data-reveal="fade-up">
      <div>
        <Heading level={2} size="h3" class="text-surface">{thankYou.nextTitle}</Heading>
        <p class="mt-2 max-w-xl text-small text-inverse-muted sm:mt-3 sm:text-body">{thankYou.nextText}</p>
        <AdvisorsChip tone="dark" class="mt-7" />
      </div>
      <div class="lg:justify-self-end">
        <Button href={site.links.calendly} external variant="light" size="lg" icon="calendar" arrow track="ScheduleCallClick">Book my free review</Button>
      </div>
    </Card>
  </Container>
</section>
