---
import SkylineArt from '@/components/shared/SkylineArt.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import { site } from '@/lib/site';
import type { Guide } from '@/types/site';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
---

<section class="pt-4 pb-12 sm:pb-16" aria-labelledby="final-cta-title">
  <Container>
    <div class="ambient-glow-dark relative overflow-hidden rounded-xl border border-inverse-border px-5 py-10 text-center shadow-lg sm:px-16 sm:py-20" data-reveal="scale">
      <SkylineArt class="absolute -right-10 bottom-0 w-[30rem] text-gold-500/25" />
      <div class="relative mx-auto max-w-2xl">
        <Heading level={2} id="final-cta-title" class="text-surface">
          {guide.cta.title}{' '}<span class="text-gold">{guide.cta.accent}</span>
        </Heading>
        <p class="mt-3 text-small text-inverse-muted sm:mt-5 sm:text-lead">{guide.cta.text}</p>
        <div class="mt-7 flex flex-col justify-center gap-2.5 sm:mt-10 sm:flex-row sm:gap-3">
          <Button href="#get-guide" variant="accent" size="lg" icon="download" arrow>{guide.submitLabel}</Button>
          <Button href={site.links.calendly} external variant="light" size="lg" icon="calendar" track="ScheduleCallClick">Book a free review</Button>
        </div>
      </div>
    </div>
  </Container>
</section>
