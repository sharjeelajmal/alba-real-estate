---
/**
 * Guide hero: the real guide cover is the visual. Headline and Jorge's credentials on the left,
 * the cover on the right. One orchestrated load: headline lines rise from a mask, the cover settles.
 */
import { Image } from 'astro:assets';
import ftCover from '@/assets/images/guides/first-time-homebuyer-cover.jpg';
import seCover from '@/assets/images/guides/self-employed-borrower-cover.jpg';
import jorge from '@/assets/images/jorge-alba.jpg';
import { site } from '@/lib/site';
import type { Guide } from '@/types/site';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const COVERS = { 'first-time-homebuyer-guide': ftCover, 'self-employed-borrower-guide': seCover } as const;
const cover = COVERS[guide.formName as keyof typeof COVERS];
const { individualNmls, companyName, companyNmls } = site.licenses;
const lines = [guide.headline, guide.headlineAccent];
---

<section class="overflow-hidden bg-paper" aria-labelledby="hero-title">
  <div class="mx-auto grid max-w-[72rem] items-center gap-12 px-(--spacing-container) pt-10 pb-14 sm:pt-16 sm:pb-20 lg:min-h-[min(calc(100svh-4rem),52rem)] lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:py-20">
    <div>
      <p class="flex items-center gap-3 text-xs font-medium text-stone animate-fade">
        <span class="h-px w-7 bg-stone/60" aria-hidden="true"></span>
        Free guide, instant download
      </p>

      <h1 id="hero-title" class="mt-5 font-heading text-[2.25rem] leading-[1.04] font-semibold tracking-[-0.015em] text-ink sm:text-[3.6rem] lg:text-[4.1rem]">
        {
          lines.map((line, i) => (
            <span class="block overflow-hidden pb-[0.08em]">
              <span class="block animate-rise" style={`animation-delay:${100 + i * 120}ms`}>{line}</span>
            </span>
          ))
        }
      </h1>

      <p class="mt-5 max-w-[32rem] text-base leading-[1.7] text-graphite animate-fade animation-delay-400 sm:mt-6 sm:text-[1.0625rem]">{guide.intro}</p>
      {guide.introBy && <p class="mt-3 text-[0.9375rem] font-medium text-ink animate-fade animation-delay-400">{guide.introBy}</p>}

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-4 sm:gap-x-7 animate-fade animation-delay-500" data-hero-cta>
        <a
          href="#get-guide"
          class="group/btn inline-flex h-13 items-center gap-3 rounded-[3px] bg-ink px-5 text-[0.9375rem] sm:px-7 font-semibold whitespace-nowrap text-white transition-colors duration-300 hover:bg-black"
        >
          Get the free guide
          <svg class="size-4 transition-transform duration-300 ease-out-expo group-hover/btn:translate-y-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v9m0 0 3.5-3.5M8 11 4.5 7.5M2.5 14h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href={site.links.calendly} target="_blank" rel="noopener" data-track="ScheduleCallClick" class="text-[0.9375rem] font-medium whitespace-nowrap text-ink underline decoration-stone/50 underline-offset-[6px] transition-colors hover:decoration-ink">
          Book a 15-min call
        </a>
      </div>

      <figure class="mt-10 flex items-center gap-4 border-t border-hairline pt-7 animate-fade animation-delay-600 sm:mt-12">
        <Image src={jorge} alt="Jorge Alba" widths={[96, 160]} sizes="52px" loading="eager" class="size-13 rounded-full object-cover object-top" />
        <figcaption class="text-[0.8125rem] leading-relaxed text-graphite">
          <span class="block text-[0.9375rem] font-semibold text-ink"><span class="hidden sm:inline">Written by </span>Jorge Alba, Mortgage Advisor</span>
          NMLS #{individualNmls}<span class="hidden sm:inline"> &nbsp;|&nbsp; </span><br class="sm:hidden" />{companyName}, NMLS #{companyNmls}
        </figcaption>
      </figure>
    </div>

    <!-- The guide itself -->
    <div class="relative mx-auto w-[min(78%,22rem)] animate-panel animation-delay-300 lg:w-full lg:max-w-[24rem]">
      <div class="absolute inset-0 translate-x-5 translate-y-5 rounded-[2px] bg-[#e9e4da] sm:translate-x-7 sm:translate-y-7" aria-hidden="true"></div>
      <Image
        src={cover}
        alt={`Cover of the free ${guide.seo.title}`}
        widths={[400, 600, 800]}
        sizes="(min-width: 1024px) 384px, 78vw"
        loading="eager"
        fetchpriority="high"
        class="relative w-full rounded-[2px] shadow-[0_30px_60px_-20px_rgb(20_19_17/0.35),0_2px_6px_rgb(20_19_17/0.08)]"
      />
    </div>
  </div>
</section>
