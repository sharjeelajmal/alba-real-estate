---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  /** site = full layout width, prose = reading width */
  size?: 'site' | 'prose';
  class?: string;
}

const { as: Tag = 'div', size = 'site', class: className } = Astro.props;
---

<Tag class:list={['mx-auto w-full px-(--spacing-container)', size === 'site' ? 'max-w-site' : 'max-w-prose', className]}>
  <slot />
</Tag>
