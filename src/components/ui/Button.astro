---
import type { HTMLAttributes } from 'astro/types';
import type { TrackEvent } from '@/constants/tracking';
import Icon, { type IconName } from './Icon.astro';

type Variant = 'primary' | 'accent' | 'outline' | 'outline-gold' | 'ghost' | 'light';
type Size = 'sm' | 'md' | 'lg';

type BaseProps = {
  variant?: Variant;
  size?: Size;
  /** Icon before the label */
  icon?: IconName;
  /** Signature gold circle with an arrow after the label */
  arrow?: boolean;
  /** Plain icon after the label (slides on hover) */
  iconAfter?: IconName;
  block?: boolean;
  /** Conversion event fired on click */
  track?: TrackEvent;
  class?: string;
};

type LinkProps = BaseProps & { href: string; external?: boolean } & Omit<HTMLAttributes<'a'>, 'class'>;
type ButtonProps = BaseProps & { href?: undefined; type?: 'button' | 'submit' } & Omit<HTMLAttributes<'button'>, 'class' | 'type'>;
type Props = LinkProps | ButtonProps;

const {
  variant = 'primary',
  size = 'md',
  icon,
  arrow = false,
  iconAfter,
  block = false,
  track,
  class: className,
  ...rest
} = Astro.props;

const VARIANTS: Record<Variant, string> = {
  primary: 'bg-linear-to-b from-espresso-700 to-espresso-950 text-primary-foreground shadow-md hover:from-espresso-800 hover:shadow-lg',
  accent: 'bg-linear-to-b from-gold-500 via-gold-600 to-gold-700 text-accent-foreground shadow-gold hover:to-gold-800',
  outline: 'border border-border-strong bg-surface/70 text-heading backdrop-blur hover:border-gold-500 hover:bg-surface',
  'outline-gold': 'border border-gold-500/70 bg-espresso-950/40 text-surface shadow-glow hover:border-gold-300 hover:bg-espresso-950/70',
  ghost: 'text-heading hover:text-accent',
  light: 'bg-surface text-primary shadow-sm hover:shadow-md',
};

/** Arrow-circle color per variant */
const ARROW: Record<Variant, string> = {
  primary: 'bg-gold-500 text-espresso-950',
  accent: 'bg-surface/25 text-surface',
  outline: 'bg-primary text-gold-300',
  'outline-gold': 'bg-gold-500 text-espresso-950',
  ghost: 'bg-accent-soft text-accent',
  light: 'bg-primary text-gold-300',
};

const SIZES: Record<Size, { base: string; withArrow: string; circle: string; icon: string }> = {
  sm: { base: 'min-h-10 px-4 text-small gap-2', withArrow: 'min-h-10 pl-4 pr-1 text-small gap-2.5', circle: 'size-8', icon: 'size-4' },
  md: { base: 'min-h-12 px-5 text-small gap-2 sm:min-h-13 sm:px-7', withArrow: 'min-h-12 pl-5 pr-1.5 text-small gap-3 sm:min-h-13 sm:pl-6 sm:pr-2', circle: 'size-9', icon: 'size-4.5' },
  lg: { base: 'min-h-12 px-6 text-small gap-2.5 sm:min-h-15 sm:px-8 sm:text-body', withArrow: 'min-h-12 pl-6 pr-1.5 text-small gap-3 sm:min-h-15 sm:pl-8 sm:pr-2 sm:text-body', circle: 'size-9 sm:size-11', icon: 'size-4.5 sm:size-5' },
};

const s = SIZES[size];
const classes = [
  'group/btn relative inline-flex select-none items-center justify-center whitespace-nowrap rounded-full font-semibold',
  'transition-[background-color,color,border-color,box-shadow,translate,scale] duration-300 ease-out-expo',
  'hover:-translate-y-0.5 active:translate-y-0 active:scale-98',
  'disabled:pointer-events-none disabled:opacity-60 aria-busy:pointer-events-none aria-busy:opacity-75',
  VARIANTS[variant],
  arrow ? s.withArrow : s.base,
  block && 'w-full',
  className,
];

const isLink = 'href' in rest && typeof rest.href === 'string';
const external = isLink && (rest as LinkProps).external;
---

{
  isLink ? (
    <a
      {...(rest as LinkProps)}
      class:list={classes}
      data-track={track}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
    >
      {icon && <Icon name={icon} class={s.icon} />}
      <span class:list={[arrow && block && 'flex-1 text-center']}><slot /></span>
      {arrow && (
        <span class:list={['grid shrink-0 place-items-center rounded-full transition-[rotate,scale] duration-500 ease-out-expo group-hover/btn:-rotate-45', s.circle, ARROW[variant]]}>
          <Icon name="arrow-right" class={s.icon} strokeWidth={2.2} />
        </span>
      )}
      {iconAfter && <Icon name={iconAfter} class:list={[s.icon, 'transition-transform duration-300 ease-out-expo group-hover/btn:translate-x-1']} />}
    </a>
  ) : (
    <button {...(rest as ButtonProps)} type={(rest as ButtonProps).type ?? 'button'} class:list={classes} data-track={track}>
      {icon && <Icon name={icon} class={s.icon} />}
      <span class:list={[arrow && block && 'flex-1 text-center']}><slot /></span>
      {arrow && (
        <span class:list={['grid shrink-0 place-items-center rounded-full transition-[rotate,scale] duration-500 ease-out-expo group-hover/btn:-rotate-45', s.circle, ARROW[variant]]}>
          <Icon name="arrow-right" class={s.icon} strokeWidth={2.2} />
        </span>
      )}
      {iconAfter && <Icon name={iconAfter} class:list={[s.icon, 'transition-transform duration-300 ease-out-expo group-hover/btn:translate-x-1']} />}
    </button>
  )
}
