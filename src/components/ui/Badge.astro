---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon?: IconName;
  tone?: 'accent' | 'neutral' | 'inverse';
  class?: string;
}

const { icon, tone = 'accent', class: className } = Astro.props;

const TONES = {
  accent: 'bg-accent-soft text-accent border-gold-300/60',
  neutral: 'bg-surface text-heading border-border',
  inverse: 'bg-surface/10 text-inverse-foreground border-inverse-border',
} as const;
---

<span class:list={['inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-caption font-semibold', TONES[tone], className]}>
  {icon && <Icon name={icon} class="size-4" strokeWidth={2} />}
  <slot />
</span>
