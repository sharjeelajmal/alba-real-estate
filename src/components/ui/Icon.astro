  'map-pin': '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6L12 3z"/><path d="M8.7 12l2.3 2.3 4.3-4.6"/>',
  home: '<path d="M4 10.5L12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1v-9.5z"/>',
  refresh: '<path d="M20 11a8 8 0 0 0-14.3-4.9L4 8M4 4v4h4M4 13a8 8 0 0 0 14.3 4.9L20 16M20 20v-4h-4"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M16 7l3 3M14 9l2 2"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M8.5 7V5.5A1.5 1.5 0 0 1 10 4h4a1.5 1.5 0 0 1 1.5 1.5V7M3 12.5h18"/>',
  star: '<path d="M12 3.8l2.5 5.1 5.6.8-4 3.9.9 5.6-5-2.6-5 2.6.9-5.6-4-3.9 5.6-.8L12 3.8z"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"/>',
  'file-text': '<path d="M14 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5z"/><path d="M14 3.5v5h5M8.5 13h7M8.5 16.5h5"/>',
  percent: '<path d="M18.5 5.5l-13 13"/><circle cx="7.5" cy="7.5" r="2.25"/><circle cx="16.5" cy="16.5" r="2.25"/>',
  'credit-card': '<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 15h3"/>',
  'alert-triangle': '<path d="M12 4.5l8.5 15h-17z"/><path d="M12 10v4M12 17h.01"/>',
  handshake: '<path d="M3 11l4-4 4 2 3-2 3 1 4 4"/><path d="M7 7v6l5 5 2-2M10 14l3 3M13 12l3 3"/>',
  'badge-check': '<path d="M12 3l2.4 1.7 2.9-.1.9 2.8 2.4 1.7-.9 2.9.9 2.8-2.4 1.7-.9 2.8-2.9-.1L12 21l-2.4-1.7-2.9.1-.9-2.8L3.4 15l.9-2.8-.9-2.9 2.4-1.7.9-2.8 2.9.1z"/><path d="M8.8 12.2l2.2 2.2 4.3-4.6"/>',
  sparkle: '<path d="M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9-1.9 5.1-1.9-5.1-5.1-1.9 5.1-1.9z"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  facebook: '<path d="M14.5 8.5H16V5.6a19 19 0 0 0-2.2-.1c-2.2 0-3.8 1.4-3.8 3.9v2.2H7.6v3.2H10V21h3.2v-6.2h2.5l.4-3.2h-2.9V9.7c0-.9.3-1.2 1.3-1.2z"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.8"/><path d="M17.2 6.8h.01"/>',
  linkedin: '<rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/><path d="M8 10.5V16M8 7.8h.01M11.5 16v-3.2a2 2 0 0 1 4 0V16M11.5 10.5V16"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.5 9.5l4.5 2.5-4.5 2.5z"/>',
  play: '<path d="M8.5 6.5v11l9-5.5z" fill="currentColor" stroke="none"/>',
  'play-circle': '<circle cx="12" cy="12" r="9"/><path d="M10.2 8.8v6.4l5-3.2z" fill="currentColor" stroke="none"/>',
  x: '<path d="M4.5 4.5l15 15M19.5 4.5l-15 15"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  class?: string;
  /** Provide a label only when the icon conveys meaning on its own. */
  label?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', label, strokeWidth = 1.8 } = Astro.props;
---

<svg
  class:list={['shrink-0', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={PATHS[name]}
/>
