---
/**
 * Inline stroke icons (24x24 grid). Inherit color and size from the parent text.
 * Add new icons to PATHS; the name type updates automatically.
 */
const PATHS = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.2l2.4 2.4 4.6-4.9"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  download: '<path d="M12 4v11M7 10.5l5 5 5-5M5 20h14"/>',
  phone: '<path d="M6.6 3.5h2.6l1.6 4.2-2 1.4a12 12 0 0 0 6.1 6.1l1.4-2 4.2 1.6v2.6a2.1 2.1 0 0 1-2.1 2.1A15.9 15.9 0 0 1 4.5 5.6a2.1 2.1 0 0 1 2.1-2.1z"/>',
